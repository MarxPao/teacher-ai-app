{
  "manifest_version": 3,
  "name": "Teacher AI — Skill Recorder",
  "version": "0.1.0",
  "description": "Grava navegacoes de leitura em portais escolares e converte em Skill Graphs declarativos (somente leitura, sem escrita).",

  "host_permissions": [
    "*://*.paineldoaluno.com.br/*",
    "*://*.machadosobrinho.com.br/*",
    "*://*.machadosobrinho.paineldoaluno.com.br/*",
    "http://localhost/*"
  ],

  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Teacher AI - Gravador de Skills"
  },

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": [
        "*://*.paineldoaluno.com.br/*",
        "*://*.machadosobrinho.com.br/*",
        "*://*.machadosobrinho.paineldoaluno.com.br/*"
      ],
      "js": ["content_script.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],

  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
