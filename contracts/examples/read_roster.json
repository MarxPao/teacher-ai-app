{
  "spec_version": "2.0",
  "identity": {
    "portal_id": "synthetic_portal",
    "domain": "localhost:8899",
    "task_id": "read_roster",
    "version": 1,
    "name": "Ler Roster com Paginação",
    "description": "Extrai lista de alunos com paginação do portal sintético"
  },
  "compat": {
    "support_tier": 1,
    "archetype_tags": ["table", "pagination"],
    "tested_archetypes": ["pagination"],
    "min_runner_version": "2.0.0"
  },
  "params": {
    "turma": {
      "type": "class_ref",
      "required": true,
      "pii": false,
      "description": "Identificador da turma"
    }
  },
  "entry_fingerprint": {
    "route": {
      "host": "localhost:8899",
      "path_pattern": "/portal/scenario/pagination"
    },
    "landmarks": [
      {
        "candidates": [
          { "strategy": "css", "selector": "#paged-table" }
        ],
        "description": "Tabela paginada presente"
      }
    ]
  },
  "entry_node": "nav_page",
  "nodes": {
    "nav_page": {
      "label": "Navega para a página de chamada paginada",
      "type": "NAVIGATE",
      "path": "/portal/scenario/pagination",
      "host": "localhost:8899",
      "retry": { "max_attempts": 2, "backoff_ms": 300 },
      "timeout_ms": 5000,
      "postconditions": [],
      "on_success": "locate_table",
      "on_fail": "$abort"
    },
    "locate_table": {
      "label": "Localiza a tabela paginada no DOM",
      "type": "LOCATE",
      "anchor": {
        "candidates": [
          { "strategy": "css", "selector": "#paged-table" },
          { "strategy": "role_name", "role": "table", "name": "Chamada Paginada" }
        ],
        "description": "Tabela de alunos"
      },
      "mode": "paginate_until_found",
      "retry": { "max_attempts": 2, "backoff_ms": 300 },
      "timeout_ms": 5000,
      "postconditions": [],
      "on_success": "read_roster_table",
      "on_fail": "$abort"
    },
    "read_roster_table": {
      "label": "Lê todos os registros tabulares da página",
      "type": "READ",
      "source": {
        "kind": "table",
        "anchor": {
          "candidates": [
            { "strategy": "css", "selector": "#paged-table" }
          ],
          "description": "Tabela paginada"
        }
      },
      "into": "alunos_extraidos",
      "paginate": true,
      "skip_rows": [
        {
          "column_labels": ["Nome", "Aluno"],
          "match": "normalized",
          "values": ["Total", "Média", "Subtotal"]
        }
      ],
      "skip_empty_rows": true,
      "retry": { "max_attempts": 2, "backoff_ms": 300 },
      "timeout_ms": 5000,
      "postconditions": [
        {
          "op": "count_gte",
          "anchor": {
            "candidates": [
              { "strategy": "css", "selector": "#paged-table tbody tr" }
            ],
            "description": "Linhas da tabela"
          },
          "n": 1
        }
      ],
      "on_success": "$end",
      "on_fail": "$abort"
    }
  },
  "canonical_mapping": {
    "columns": [
      {
        "portal_labels": ["ID", "Matrícula"],
        "field": "student.portal_id",
        "semantic_type": "identifier"
      },
      {
        "portal_labels": ["Nome", "Nome do Aluno"],
        "field": "student.name",
        "semantic_type": "name",
        "transform": "normalize_name"
      },
      {
        "portal_labels": ["Nota"],
        "field": "grade.value",
        "semantic_type": "numeric_grade",
        "transform": "parse_decimal_pt_br"
      }
    ],
    "grade_scale": {
      "type": "numeric",
      "min": 0,
      "max": 10,
      "decimal_separator": "."
    },
    "attendance": {
      "polarity": "checked_is_absent"
    },
    "ambiguous_requires_confirmation": true
  },
  "pagination": {
    "type": "next_button",
    "next": {
      "candidates": [
        { "strategy": "css", "selector": ".btn-proxima-pagina" },
        { "strategy": "role_name", "role": "button", "name": "Próxima >" }
      ],
      "description": "Botão para avançar página"
    },
    "max_pages": 10,
    "delay_ms": { "min": 200, "max": 600 }
  },
  "safety": {
    "side_effect_level": "read",
    "writes_require_checkpoint": true,
    "max_writes_per_run": 0,
    "rate_limit": { "min_delay_ms": 100, "jitter_ms": 50 },
    "allowed_hosts": ["localhost:8899"]
  },
  "provenance": {
    "author": "teacher_ai_recorder",
    "created_at": "2026-10-10T12:00:00Z",
    "updated_at": "2026-10-10T12:00:00Z",
    "source": "recorded",
    "has_self_healed": false,
    "pii_scrubbed": true
  }
}
