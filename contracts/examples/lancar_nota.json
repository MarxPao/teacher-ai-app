{
  "spec_version": "2.0",
  "identity": {
    "portal_id": "synthetic_portal",
    "domain": "localhost:8899",
    "task_id": "lancar_nota",
    "version": 1,
    "name": "Lançar Notas em Lote",
    "description": "Lança notas em lote com checkpoint prévio, loop e desvio condicional"
  },
  "compat": {
    "support_tier": 1,
    "archetype_tags": ["standard_table", "input_grades"],
    "tested_archetypes": ["standard"],
    "min_runner_version": "2.0.0"
  },
  "params": {
    "disciplina": {
      "type": "string",
      "required": true,
      "pii": false,
      "description": "Nome do componente curricular"
    },
    "lote_notas": {
      "type": "list",
      "required": true,
      "pii": true,
      "description": "Lista de objetos com { aluno, valor }"
    }
  },
  "entry_node": "nav_diario",
  "nodes": {
    "nav_diario": {
      "label": "Acessa página do diário de classe",
      "type": "NAVIGATE",
      "path": "/portal/standard",
      "host": "localhost:8899",
      "retry": { "max_attempts": 2, "backoff_ms": 300 },
      "timeout_ms": 5000,
      "postconditions": [],
      "on_success": "checkpoint_lote",
      "on_fail": "$abort"
    },
    "checkpoint_lote": {
      "label": "Aprovação prévia do professor para lançamento em lote",
      "type": "CHECKPOINT",
      "summary": [
        { "label": "Disciplina", "value": { "param": "disciplina" } },
        { "label": "Registros no Lote", "value": { "param": "lote_notas" } }
      ],
      "scope": "per_batch",
      "on_reject": "$abort",
      "retry": { "max_attempts": 1, "backoff_ms": 0 },
      "timeout_ms": 30000,
      "postconditions": [],
      "on_success": "loop_lancamento",
      "on_fail": "$abort"
    },
    "loop_lancamento": {
      "label": "Itera sobre cada registro de nota do lote",
      "type": "LOOP",
      "over": { "kind": "param_list", "param": "lote_notas" },
      "as": "item",
      "body_entry": "ramifica_se_preenchido",
      "max_iterations": 50,
      "skip_rows": [
        {
          "column_labels": ["Nome do Aluno", "Discente"],
          "match": "normalized",
          "values": ["Total", "Média", "Subtotal"]
        }
      ],
      "skip_empty_rows": true,
      "retry": { "max_attempts": 1, "backoff_ms": 0 },
      "timeout_ms": 10000,
      "postconditions": [],
      "on_success": "salvar_diario",
      "on_fail": "$abort"
    },
    "ramifica_se_preenchido": {
      "label": "Verifica se a nota do item está vazia",
      "type": "BRANCH",
      "condition": {
        "op": "var_empty",
        "var": "item.valor"
      },
      "on_true": "ignora_item",
      "on_false": "digita_nota",
      "retry": { "max_attempts": 1, "backoff_ms": 0 },
      "timeout_ms": 1000,
      "postconditions": []
    },
    "ignora_item": {
      "label": "Pula aluno sem nota informada",
      "type": "WAIT",
      "ms": 10,
      "retry": { "max_attempts": 1, "backoff_ms": 0 },
      "timeout_ms": 1000,
      "postconditions": [],
      "on_success": "$continue",
      "on_fail": "$abort"
    },
    "digita_nota": {
      "label": "Digita a nota do aluno na célula correspondente",
      "type": "WRITE",
      "anchor": {
        "candidates": [
          { "strategy": "css", "selector": "input[type='number']" }
        ],
        "scope": {
          "within": {
            "table": {
              "candidates": [
                { "strategy": "css", "selector": "#tabela-alunos" }
              ],
              "description": "Tabela de Diário"
            },
            "key": {
              "column_labels": ["Nome do Aluno"],
              "equals": { "var": "item.aluno" },
              "match": "normalized"
            }
          }
        },
        "description": "Input numérico de nota"
      },
      "value": { "var": "item.valor" },
      "method": "type_native",
      "semantic": "grade",
      "read_back": true,
      "retry": { "max_attempts": 2, "backoff_ms": 300 },
      "timeout_ms": 5000,
      "postconditions": [],
      "on_success": "$continue",
      "on_fail": "$abort"
    },
    "salvar_diario": {
      "label": "Submete notas gravadas no diário de classe",
      "type": "CLICK",
      "anchor": {
        "candidates": [
          { "strategy": "css", "selector": "#btn-salvar" }
        ],
        "description": "Botão Salvar Lançamentos"
      },
      "is_submit_action": true,
      "retry": { "max_attempts": 2, "backoff_ms": 500 },
      "timeout_ms": 5000,
      "postconditions": [],
      "on_success": "$end",
      "on_fail": "$abort"
    }
  },
  "canonical_mapping": {
    "columns": [
      {
        "portal_labels": ["Nome do Aluno"],
        "field": "student.name",
        "semantic_type": "name"
      },
      {
        "portal_labels": ["Nota"],
        "field": "grade.value",
        "semantic_type": "numeric_grade"
      }
    ],
    "grade_scale": {
      "type": "numeric",
      "min": 0,
      "max": 10,
      "decimal_separator": "."
    },
    "attendance": {
      "polarity": "not_applicable"
    },
    "ambiguous_requires_confirmation": true
  },
  "safety": {
    "side_effect_level": "write",
    "writes_require_checkpoint": true,
    "max_writes_per_run": 50,
    "rate_limit": { "min_delay_ms": 100, "jitter_ms": 50 },
    "allowed_hosts": ["localhost:8899"]
  },
  "provenance": {
    "author": "teacher_ai_recorder",
    "created_at": "2026-10-10T12:00:00Z",
    "updated_at": "2026-10-10T12:00:00Z",
    "source": "recorded",
    "has_self_healed": false,
    "pii_scrubbed": true
  }
}
