# ==============================================================================
# TEACHER AI — EXEMPLO DE VARIÁVEIS DE AMBIENTE
# Copie este arquivo para .env.local e preencha com suas configurações.
# NUNCA comite o arquivo .env.local (está devidamente listado no .gitignore).
# ==============================================================================

# ── SUPABASE (BANCO DE DADOS & AUTENTICAÇÃO) ──────────────────────────────────
# URL pública do projeto Supabase (acessível no cliente e servidor)
NEXT_PUBLIC_SUPABASE_URL=https://COLE_SEU_PROJETO.supabase.co
# Chave pública anônima do Supabase com restrição RLS (acessível no cliente e servidor)
NEXT_PUBLIC_SUPABASE_ANON_KEY=COLE_SUA_ANON_KEY_AQUI
# [SOMENTE SERVIDOR] Chave de serviço administrativa do Supabase (ignora RLS, NUNCA expor ao cliente)
SUPABASE_SERVICE_ROLE_KEY=COLE_SUA_SERVICE_ROLE_KEY_AQUI
# [SOMENTE SERVIDOR] Token de acesso pessoal de gerenciamento Supabase (CLI/Deploy)
SUPABASE_ACCESS_TOKEN=COLE_SEU_ACCESS_TOKEN_AQUI
# [SOMENTE SERVIDOR] Identificador de referência do projeto Supabase
SUPABASE_PROJECT_REF=COLE_SEU_PROJECT_REF_AQUI

# ── PROVEDORES DE IA (TODAS AS CHAVES SÃO ESTRITAMENTE SOMENTE SERVIDOR) ──────
# [SOMENTE SERVIDOR] Chave de API Google Gemini (modelo primário de geração e visão)
GEMINI_API_KEY=COLE_SUA_CHAVE_AQUI
# [SOMENTE SERVIDOR] Chave de API Groq (inferência rápida Llama / Whisper)
GROQ_API_KEY=COLE_SUA_CHAVE_AQUI
# [SOMENTE SERVIDOR] Chave de API OpenAI (GPT-4o fallback)
OPENAI_API_KEY=COLE_SUA_CHAVE_AQUI
# [SOMENTE SERVIDOR] Chave de API Anthropic Claude
ANTHROPIC_API_KEY=COLE_SUA_CHAVE_AQUI
# [SOMENTE SERVIDOR] Chave de API DeepSeek
DEEPSEEK_API_KEY=COLE_SUA_CHAVE_AQUI
# [SOMENTE SERVIDOR] Chave de API ElevenLabs (Text-to-Speech)
ELEVENLABS_API_KEY=COLE_SUA_CHAVE_AQUI

# ── SIDECAR & AUTOMAÇÃO LOCAL ─────────────────────────────────────────────────
# [SOMENTE SERVIDOR] Endpoint do Chrome DevTools Protocol para o Sidecar Python
CDP_URL=http://localhost:9222
