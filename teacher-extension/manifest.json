{
  "manifest_version": 3,
  "key": "",
  "name": "TeacherAI - Assistente Agêntico",
  "version": "3.1",
  "description": "Extensão inteligente que conecta aos portais escolares e ao painel TeacherAI.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "Teacher AI — Assistente no Portal",
    "default_icon": {
      "16": "icons/icon_red_16.png",
      "48": "icons/icon_red_48.png",
      "128": "icons/icon_red_128.png"
    }
  },
  "side_panel": {
    "default_path": "side_panel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "sidePanel",
    "scripting",
    "debugger",
    "nativeMessaging",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "portal_normalizer.js",
        "transaction_manager.js",
        "session_guardian.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost/*",
      "http://127.0.0.1/*"
    ]
  },
  "web_accessible_resources": [
    {
      "resources": ["side_panel.html", "side_panel.js"],
      "matches": ["http://localhost/*", "http://127.0.0.1/*"]
    }
  ]
}